{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.0.1",
  "description": "Shows a quiet focus page for sites blocked by Focus Guard.",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "startup",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-guard@danielsintimbrean",
      "strict_min_version": "128.0"
    }
  }
}
